{
  "format": "cytools-meshstudio-workflow",
  "schemaVersion": 1,
  "name": "Image to quick preview (LocalMesh draft)",
  "description": "A first look before a long run: one image, cut out, then LocalMesh at the Draft tier (512 grid, 8 passes, 80 000 faces, 2K texture). Use it to check the cut-out and the general shape, then run a High or Max workflow on the same image.",
  "input_mode": "each",
  "createdAt": "2026-09-24T14:02:46.630979+00:00",
  "updatedAt": "2026-09-24T14:02:46.630979+00:00",
  "steps": [
