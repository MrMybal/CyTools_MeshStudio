{
  "format": "cytools-meshstudio-workflow",
  "schemaVersion": 1,
  "name": "Image to maximum-quality mesh (LocalMesh max)",
  "description": "The finest shape LocalMesh can build: the 1536 grid (3.4 times more cells than High), 16 passes, 400 000 faces, 8K texture, baked normal map. It needs a 24 GB card, and the grid is lowered by steps of 128 when the free VRAM at the start is not enough: close the other programs that use the GPU first. The report gives the grid actually used.",
  "input_mode": "each",
  "createdAt": "2026-09-24T14:02:46.631983+00:00",
  "updatedAt": "2026-09-24T14:02:46.631983+00:00",
  "steps": [
    {
      "id": "subject",
      "operation": "prepare_subject",
      "backend": "birefnet",
      "parameters": {
        "common_framing": true,
        "measure_camera": false,
        "contact_sheet": true
      },
      "input_from": "",
      "input_field": "",
      "input_to": "",
      "extra_inputs": [],
      "enabled": true,
      "continue_on_error": false
    },
    {
      "id": "shape",
      "operation": "photos_to_mesh",
      "backend": "trellis",
      "parameters": {
        "mode": "single",
        "tier": "max",
        "seed": -1,
        "gpu": 0,
        "sampler": "recipe",
        "transparency": "auto",
        "up_axis": "y",
        "texture_size": 0,
        "target_faces": 0,
        "real_size_mm": 0,
        "fidelity": 0,
        "tex_guidance": 0,
        "steps_structure": 0,
        "steps_shape": 0,
        "steps_texture": 0,
        "bake_normal_map": true,
        "origin_at_base": true,
        "remove_floaters": true,
        "fill_holes": true
      },
      "input_from": "subject",
      "input_field": "subject_set",
      "input_to": "subject_set",
      "extra_inputs": [],
      "enabled": true,
      "continue_on_error": false
    }
  ]
}
