{
  "format": "cytools-meshstudio-workflow",
  "schemaVersion": 1,
  "name": "Image to production mesh with Hi3DGen",
  "description": "Same chain as LocalMesh+, with Hi3DGen for the shape: the picture becomes a sharp normal map (StableNormal YOSO), then a mesh (TRELLIS v1 retrained on normals, 256 grid). Tick the optional \"refine\" step to regenerate its detail on the 1536 grid with TRELLIS.2 before the quads and the texture. Run the LocalMesh+ workflow on the same picture to compare.",
  "createdAt": "2026-09-23T14:06:38.972375+00:00",
  "updatedAt": "2026-09-23T14:06:38.972375+00:00",
  "steps": [
    {
      "id": "subject",
      "operation": "prepare_subject",
      "backend": "birefnet",
      "parameters": {
        "common_framing": true,
        "measure_camera": false,
        "contact_sheet": true
      },
      "input_from": "",
      "input_field": "",
      "input_to": "",
      "extra_inputs": [],
      "enabled": true,
      "continue_on_error": false
    },
    {
      "id": "shape",
      "operation": "image_to_mesh_hi3dgen",
      "backend": "hi3dgen",
      "parameters": {
        "seed": -1,
        "normal_resolution": 768,
        "ss_steps": 50,
        "ss_guidance": 3.0,
        "slat_steps": 6,
        "slat_guidance": 3.0,
        "origin_at_base": true,
        "gpu": 0
      },
      "input_from": "subject",
      "input_field": "subject_set",
      "input_to": "subject_set",
      "extra_inputs": [],
      "enabled": true,
      "continue_on_error": false
    },
    {
      "id": "refine",
      "operation": "refine_mesh",
      "backend": "trellis",
      "parameters": {
        "resolution": 1536,
        "target_faces": 0,
        "use_all_views": false,
        "steps": 16,
        "guidance": 0,
        "seed": -1,
        "up_axis": "y",
        "gpu": 0
      },
      "input_from": "shape",
      "input_field": "file",
      "input_to": "mesh_file",
      "extra_inputs": [
        {
          "from": "subject",
          "field": "subject_set",
          "to": "subject_set"
        }
      ],
      "enabled": false,
      "continue_on_error": false
    },
    {
      "id": "light",
      "operation": "mesh_edit",
      "backend": "meshedit",
      "parameters": {
        "steps": [
          {
            "action": "decimate",
            "targetFaces": 60000
          }
        ],
        "output_format": "obj",
        "keep_materials": false
      },
      "input_from": "refine",
      "input_field": "file",
      "input_to": "",
      "extra_inputs": [],
      "enabled": true,
      "continue_on_error": false
    },
    {
      "id": "quads",
      "operation": "remesh_field",
      "backend": "quadwild",
      "parameters": {
        "preRemesh": true,
        "featureAngle": 35,
        "scale": 1,
        "align": true,
        "solverSeconds": 300
      },
      "input_from": "light",
      "input_field": "mesh_file",
      "input_to": "",
      "extra_inputs": [],
      "enabled": true,
      "continue_on_error": false
    },
    {
      "id": "texture",
      "operation": "texture_mesh",
      "backend": "trellis",
      "parameters": {
        "texture_source": "generate",
        "texture_size": 4096,
        "multiview_texture": false,
        "resolution": 1024,
        "steps": 16,
        "guidance": 5.0,
        "seed": -1,
        "up_axis": "y",
        "uv_padding": 4,
        "gpu": 0
      },
      "input_from": "quads",
      "input_field": "file",
      "input_to": "mesh_file",
      "extra_inputs": [
        {
          "from": "refine",
          "field": "file",
          "to": "detail_mesh"
        },
        {
          "from": "subject",
          "field": "subject_set",
          "to": "subject_set"
        }
      ],
      "enabled": true,
      "continue_on_error": false
    }
  ]
}