{
  "format": "cytools-meshstudio-workflow",
  "schemaVersion": 1,
  "name": "Image to game asset (LocalMesh, AutoRemesher)",
  "description": "A light, clean asset for a game engine. LocalMesh builds the detailed model (High tier); it is lightened to 20 000 faces, AutoRemesher turns it into about 4 000 quads, and TRELLIS.2 generates a 2K texture for that exact mesh, with a normal map baked from the detailed model so the relief survives. The OBJ keeps the quads, the GLB is ready for Unity, Unreal or Godot. Raise target_quads in the \"quads\" step for a hero asset.",
  "input_mode": "each",
  "createdAt": "2026-09-24T14:02:46.631983+00:00",
  "updatedAt": "2026-09-24T14:02:46.631983+00:00",
  "steps": [
    {
      "id": "subject",
      "operation": "prepare_subject",
      "backend": "birefnet",
      "parameters": {
        "common_framing": true,
        "measure_camera": false,
        "contact_sheet": true
      },
      "input_from": "",
      "input_field": "",
      "input_to": "",
      "extra_inputs": [],
      "enabled": true,
      "continue_on_error": false
    },
    {
      "id": "shape",
      "operation": "photos_to_mesh",
      "backend": "trellis",
      "parameters": {
        "mode": "single",
        "tier": "high",
        "seed": -1,
        "gpu": 0,
        "sampler": "recipe",
        "transparency": "auto",
        "up_axis": "y",
        "texture_size": 0,
        "target_faces": 0,
        "real_size_mm": 0,
        "fidelity": 0,
        "tex_guidance": 0,
        "steps_structure": 0,
        "steps_shape": 0,
        "steps_texture": 0,
        "bake_normal_map": true,
        "origin_at_base": true,
        "remove_floaters": true,
        "fill_holes": true
      },
      "input_from": "subject",
      "input_field": "subject_set",
      "input_to": "subject_set",
      "extra_inputs": [],
      "enabled": true,
      "continue_on_error": false
    },
    {
      "id": "light",
      "operation": "mesh_edit",
      "backend": "meshedit",
      "parameters": {
        "steps": [
          {
            "action": "decimate",
            "targetFaces": 20000
          }
        ],
        "output_format": "obj",
        "keep_materials": false
      },
      "input_from": "shape",
      "input_field": "file",
      "input_to": "",
      "extra_inputs": [],
      "enabled": true,
      "continue_on_error": false
    },
    {
      "id": "quads",
      "operation": "remesh_auto",
      "backend": "",
      "parameters": {
        "target_quads": 4000,
        "edge_scaling": 1,
        "sharp_edge": 90,
        "smooth_normal": 0,
        "adaptivity": 1,
        "anisotropy": 1
      },
      "input_from": "light",
      "input_field": "mesh_file",
      "input_to": "",
      "extra_inputs": [],
      "enabled": true,
      "continue_on_error": false
    },
    {
      "id": "texture",
      "operation": "texture_mesh",
      "backend": "trellis",
      "parameters": {
        "texture_source": "generate",
        "texture_size": 2048,
        "multiview_texture": false,
        "resolution": 1024,
        "steps": 16,
        "guidance": 5.0,
        "seed": -1,
        "up_axis": "y",
        "uv_padding": 4,
        "gpu": 0
      },
      "input_from": "quads",
      "input_field": "file",
      "input_to": "mesh_file",
      "extra_inputs": [
        {
          "from": "shape",
          "field": "file",
          "to": "detail_mesh"
        },
        {
          "from": "subject",
          "field": "subject_set",
          "to": "subject_set"
        }
      ],
      "enabled": true,
      "continue_on_error": false
    }
  ]
}
