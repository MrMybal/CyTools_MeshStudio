          "capabilities": {
            "type": "object"
          },
          "library": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "urn:cytools:v1:model-library",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schemaVersion",
              "models"
            ],
            "properties": {
              "schemaVersion": {
                "const": 1
              },
              "models": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "name",
                    "path",
                    "format",
                    "kind",
                    "base",
                    "license",
                    "source",
                    "validation"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "name": {
                      "type": "string",
