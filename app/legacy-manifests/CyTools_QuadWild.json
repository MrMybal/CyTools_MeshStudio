  "operations": [
    {
      "id": "remesh",
      "name": "Remaillage quadrangulaire",
      "description": "Reconstruction quad CPU",
      "inputSchema": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "minLength": 1,
            "x-cy-kind": "File"
          },
          "preRemesh": {
            "type": "boolean",
            "default": true
          },
          "featureAngle": {
            "type": "number",
            "minimum": 0,
            "maximum": 180,
            "default": 35
          },
          "scale": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 10,
            "default": 1
          },
          "align": {
            "type": "boolean",
            "default": true
          },
          "solverSeconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600,
            "default": 200
          }
        },
        "required": [
          "input"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "vertices": {
            "type": "integer",
            "minimum": 0
          },
          "faces": {
            "type": "integer",
            "minimum": 0
          },
          "quads": {
            "type": "integer",
            "minimum": 0
          },
          "triangles": {
            "type": "integer",
            "minimum": 0
          },
          "file": {
            "type": "string"
          },
          "report": {
            "type": "string"
          },
          "mimeType": {
            "type": "string"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "vertices",
          "faces",
          "quads",
          "triangles",
          "file",
          "report",
          "mimeType",
          "warnings"
        ],
        "additionalProperties": false
      },
      "supportedBackends": [],
      "permissions": [
        "filesystemExternal"
      ],
      "resourceRequirements": {
        "ramBytes": 2147483648,
        "diskBytes": 536870912,
        "cpuThreads": 1
      },
      "canRunAsync": true,
      "canCancel": true,
