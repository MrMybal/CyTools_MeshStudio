      "id": "unwrap",
      "name": "unwrap",
      "description": "Generate UV charts and pack a single atlas.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "minLength": 1,
            "title": "Mesh OBJ / PLY / STL",
            "x-cy-kind": "File"
          },
          "resolution": {
            "type": "integer",
            "minimum": 64,
            "maximum": 4096,
            "default": 1024
          },
          "padding": {
            "type": "integer",
            "minimum": 0,
            "maximum": 32,
            "default": 4
          },
          "iterations": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "default": 1
          },
          "maxCost": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 10,
            "default": 2.0
          },
          "bruteForce": {
            "type": "boolean",
            "default": false
          },
          "rotateCharts": {
            "type": "boolean",
            "default": true
          },
          "blockAlign": {
            "type": "boolean",
            "default": false
          },
          "fixWinding": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "input"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "mesh": {
            "type": "string",
            "x-cy-kind": "File"
          },
          "preview": {
            "type": "string",
            "x-cy-kind": "File"
          },
          "mapping": {
            "type": "string",
            "x-cy-kind": "File"
          },
