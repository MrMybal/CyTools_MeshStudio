      "id": "spar3d-cuda",
      "name": "Official SPAR3D / CUDA",
      "threadSafe": false,
      "shareableModelInstance": false,
      "concurrentInference": false,
      "maxConcurrentInference": 1,
      "models": [
        {
          "id": "spar3d",
          "name": "stabilityai/stable-point-aware-3d",
          "version": "5699918cb34f55cd7d828493d2725f3038313761",
