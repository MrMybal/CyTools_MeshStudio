      "computeBackends": [
        "CPU",
        "CUDA"
      ]
    }
  ],
  "interfaces": [
    "Native",
    "CLI",
    "JSONL",
    "HTTP",
    "MCP",
    "ImGui"
  ],
  "runtimeRequirements": [],
  "concurrency": {
    "policy": "Sequential",
    "maxWorkers": 1
  },
  "operations": [
    {
      "id": "image_to_mesh",
      "name": "Image to textured mesh",
      "description": "Reconstruct one object as GLB with materials and a point cloud. Backside geometry is inferred, not measured.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "image_file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "x-cy-kind": "File",
            "description": "PNG/JPEG/WEBP inside CYTOOLS_SPAR3D_INPUT_ROOT (default: inputs)."
          },
          "texture_resolution": {
            "type": "integer",
            "enum": [
              512,
              1024,
              2048
            ],
            "default": 1024
          },
          "remesh": {
            "enum": [
              "none",
              "triangle",
              "quad"
            ],
            "default": "none",
            "description": "GLB triangulates faces even after quad remeshing."
          },
          "target_vertices": {
            "type": "integer",
            "minimum": -1,
            "maximum": 100000,
            "default": -1,
            "anyOf": [
              {
                "const": -1
              },
              {
                "minimum": 100
              }
            ],
            "description": "Approximate remeshing vertex target; -1 preserves upstream default."
          },
          "low_vram": {
            "type": "boolean",
            "default": false
          },
          "gpu_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15,
            "default": 0
          },
          "remove_background": {
            "type": "boolean",
            "default": true
          },
          "foreground_ratio": {
            "type": "number",
            "minimum": 1.1,
            "maximum": 2,
            "default": 1.3
          },
          "seed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647,
            "default": 42
          },
          "model_profile": {
            "type": "string",
            "default": "",
            "description": "ID from the local model library; empty uses the selected built-in model."
          }
        },
        "required": [
          "image_file"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "mesh_file": {
            "type": "string",
            "x-cy-kind": "File"
          },
          "point_cloud_file": {
            "type": "string",
            "x-cy-kind": "File"
          },
          "preprocessed_image": {
            "type": "string",
            "x-cy-kind": "File"
          },
          "report_file": {
            "type": "string",
            "x-cy-kind": "File"
          },
          "remesh": {
            "type": "string"
          },
          "export_topology": {
            "type": "string"
          },
          "model_id": {
            "type": "string"
          },
          "model_revision": {
            "type": "string"
          },
          "source_revision": {
            "type": "string"
          },
          "vertices": {
            "type": "integer",
            "minimum": 0
          },
          "faces": {
            "type": "integer",
            "minimum": 0
          },
          "seed": {
            "type": "integer",
            "minimum": 0
          },
          "gpu_index": {
            "type": "integer",
            "minimum": 0
          },
          "peak_vram_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "load_seconds": {
            "type": "number",
            "minimum": 0
          },
          "total_seconds": {
            "type": "number",
            "minimum": 0
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "mesh_file",
          "point_cloud_file",
          "preprocessed_image",
          "report_file",
          "remesh",
          "export_topology",
          "model_id",
          "model_revision",
          "source_revision",
          "vertices",
          "faces",
          "seed",
          "gpu_index",
          "peak_vram_bytes",
          "load_seconds",
          "total_seconds",
          "warnings"
        ],
        "additionalProperties": false
      },
      "resourceRequirements": {
        "ramBytes": 25769803776,
        "vramBytes": {
          "0": 12884901888
        },
        "diskBytes": 1073741824,
        "cpuThreads": 4,
        "networkRequired": true
      },
      "supportedBackends": [
        "spar3d-cuda"
      ],
      "permissions": [],
      "canRunAsync": true,
      "canCancel": true,
      "supportsProgress": true
    },
    {
