{
  "schemaVersion": 1,
  "protocolVersion": "1.0",
  "id": "cy.tool.spar3d",
  "name": "CyTools_SPAR3D",
  "version": "0.2.0",
  "description": "SPAR3D image to textured GLB with optional remeshing. NVIDIA CUDA backend; Windows experimental.",
  "vendor": "Cyberalien",
  "author": "Cyberalien",
  "executable": "runtime/python/Scripts/python.exe app/tool.py",
  "categories": [
    "3d",
    "image-to-mesh"
  ],
  "tags": [
    "SPAR3D",
    "GLB",
    "CUDA"
  ],
  "capabilities": [
    "jobs",
    "cancellation",
    "progress",
    "image-to-mesh"
  ],
