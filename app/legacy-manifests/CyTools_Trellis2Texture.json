  "author": "Cyberalien",
  "license": "Proprietary",
  "executable": "runtime/python/Scripts/python.exe app/tool.py",
  "standaloneExecutable": "CyTools_Trellis2Texture.exe",
  "distributionStatus": "Windows x64 launcher compiled and executed here; the private runtime is built from the Python 3.11 installed on the machine, so this is not yet a redistributable installer. Linux launcher shipped but not executed.",
  "documentation": "app/README.md",
