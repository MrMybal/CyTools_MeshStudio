    {
      "id": "generate_pbr",
      "name": "Generate the PBR maps of a mesh",
      "description": "Bake Base Color, Metallic, Roughness and Alpha into a UV atlas, plus the glTF-packed metallic-roughness map, an optional PBR GLB and a JSON report. Up to 2000000 triangles.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "mesh_file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "x-cy-kind": "File",
            "description": "Mesh path inside the configured mesh root: GLB, GLTF, OBJ, PLY, STL, OFF.",
            "x-cy-ui": {
              "help": "Relative to CYTOOLS_TRELLIS2TEXTURE_MESH_ROOT; absolute paths must stay inside it."
            }
          },
          "resolution": {
            "enum": [
              512,
              1024,
              2048,
              4096
            ],
            "default": 1024,
            "x-cy-kind": "Enum",
            "description": "Square size in texels of every generated map."
          },
          "uv_mode": {
            "enum": [
              "auto",
              "keep",
              "unwrap",
              "grid"
            ],
            "default": "auto",
            "x-cy-kind": "Enum",
            "description": "auto keeps existing UV and unwraps only when there is none; keep fails without UV; unwrap rebuilds an atlas with xatlas and falls back to grid if xatlas fails; grid gives every triangle its own cell, which never overlaps but wastes texels."
          },
          "padding_pixels": {
            "type": "integer",
            "minimum": 0,
            "maximum": 64,
            "default": 8,
            "x-cy-kind": "Integer",
            "description": "Texels of nearest-neighbour padding grown around each UV island."
          },
          "cavity_delight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.0,
            "x-cy-kind": "Float",
            "description": "Brightens concave areas to attenuate shading baked into the source colour. Geometric heuristic, not an inverse-rendering de-lighting.",
            "x-cy-ui": {
              "advanced": true,
              "step": 0.05
            }
          },
          "metallic_mode": {
            "enum": [
              "constant",
              "estimate",
              "source"
            ],
            "default": "constant",
            "x-cy-kind": "Enum",
            "description": "constant writes metallic_value; estimate applies the documented colour heuristic; source resamples the metallic-roughness texture of the mesh."
          },
          "metallic_value": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.0,
            "x-cy-kind": "Float",
            "description": "Constant metallic, and lower bound of the estimated metallic.",
            "x-cy-ui": {
              "step": 0.05
            }
          },
          "roughness_mode": {
            "enum": [
              "estimate",
              "constant",
              "source"
            ],
            "default": "estimate",
            "x-cy-kind": "Enum",
            "description": "estimate applies the documented detail heuristic; constant writes roughness_value; source resamples the mesh metallic-roughness texture."
          },
          "roughness_value": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.5,
            "x-cy-kind": "Float",
            "description": "Constant roughness, and centre of the estimated roughness.",
            "x-cy-ui": {
              "step": 0.05
            }
          },
          "alpha_mode": {
            "enum": [
              "from_source",
              "opaque",
              "from_coverage"
            ],
            "default": "from_source",
            "x-cy-kind": "Enum",
            "description": "from_source keeps the source transparency; opaque writes white; from_coverage marks the texels covered by a triangle, without padding."
          },
          "export_glb": {
            "type": "boolean",
            "default": true,
            "x-cy-kind": "Boolean",
            "description": "Also write a GLB carrying the UV layout and the generated PBR material."
          }
        },
        "required": [
          "mesh_file"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "metallic_mode": {
                  "const": "constant"
                }
              },
              "required": [
                "metallic_mode"
              ]
            },
            "then": {
              "required": [
                "metallic_value"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "roughness_mode": {
                  "const": "constant"
                }
              },
              "required": [
                "roughness_mode"
              ]
            },
            "then": {
              "required": [
                "roughness_value"
              ]
            }
          }
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "base_color_file": {
            "type": "string",
            "x-cy-kind": "File"
          },
          "metallic_file": {
            "type": "string",
            "x-cy-kind": "File"
          },
          "roughness_file": {
            "type": "string",
            "x-cy-kind": "File"
          },
          "alpha_file": {
            "type": "string",
            "x-cy-kind": "File"
          },
          "metallic_roughness_file": {
            "type": "string",
            "x-cy-kind": "File"
          },
          "material_mesh_file": {
            "type": "string",
            "x-cy-kind": "File",
            "description": "Empty when export_glb is false."
          },
          "report_file": {
            "type": "string",
            "x-cy-kind": "File"
          },
          "resolution": {
            "enum": [
              512,
              1024,
              2048,
              4096
            ]
          },
          "vertices": {
            "type": "integer",
            "minimum": 1
          },
          "faces": {
            "type": "integer",
            "minimum": 1
          },
          "uv_source": {
            "enum": [
              "existing",
              "xatlas",
              "grid"
            ]
          },
          "padding_pixels": {
            "type": "integer",
            "minimum": 0,
            "maximum": 64,
            "description": "Padding actually applied; grid mode lowers it to fit its cells."
          },
          "color_source": {
            "enum": [
              "texture",
              "vertex_colors",
              "base_color_factor",
              "none"
            ]
          },
          "metallic_mode": {
            "enum": [
              "constant",
              "estimate",
              "source"
            ]
          },
          "roughness_mode": {
            "enum": [
              "estimate",
              "constant",
              "source"
            ]
          },
          "alpha_mode": {
            "enum": [
              "from_source",
              "opaque",
              "from_coverage"
            ]
          },
          "texel_coverage": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Fraction of texels covered by a triangle, before padding."
          },
          "padded_coverage": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Fraction of texels holding a value after padding."
          },
          "stamped_faces": {
            "type": "integer",
            "minimum": 0,
            "description": "Triangles smaller than a texel, forced onto a single texel."
          },
          "source_texture_size": {
            "type": "array",
