              },
              "total_seconds": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "load_seconds",
              "bake_seconds",
              "total_seconds"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "base_color_file",
          "metallic_file",
          "roughness_file",
          "alpha_file",
          "metallic_roughness_file",
          "material_mesh_file",
          "report_file",
          "resolution",
