          "ram_budget_gib": {
            "type": "integer",
            "minimum": 1,
            "maximum": 128,
            "default": 8
          },
          "vram_budget_gib": {
            "type": "integer",
            "minimum": 1,
            "maximum": 80,
            "default": 12
          },
          "disk_budget_gib": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 4
          },
          "model_profile": {
            "type": "string",
            "default": "",
            "description": "ID from the local model library; empty uses the selected built-in model."
          }
        },
        "required": [
          "video"
        ],
        "additionalProperties": false
