    {
      "id": "reconstruct",
      "name": "Reconstruire le mouvement 3D",
      "description": "WHAM BEDLAM : poses SMPL, translations et reperes temporels en NPZ. Requiert poids et SMPL autorises.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "video": {
            "type": "string",
            "minLength": 1,
            "description": "Chemin relatif dans data/inputs, importe depuis ImGui."
          },
          "global_motion": {
            "type": "boolean",
            "default": false
          },
          "flip_eval": {
            "type": "boolean",
            "default": true
          },
          "refine": {
            "type": "boolean",
            "default": false
          },
          "gpu_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7,
            "default": 0
