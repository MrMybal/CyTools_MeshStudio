          },
          "output_format": {
            "type": "string"
          },
          "bake_texture": {
            "type": "boolean"
          },
          "has_vertex_colors": {
            "type": "boolean"
          },
          "vertices": {
            "type": "integer",
            "minimum": 0
          },
          "faces": {
            "type": "integer",
            "minimum": 0
          },
          "mc_resolution": {
            "type": "integer",
            "minimum": 0
          },
          "density_threshold": {
            "type": "number",
            "minimum": 0
          },
