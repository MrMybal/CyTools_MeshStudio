            "type": "number",
            "minimum": 0
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "mesh_file",
          "texture_file",
          "preprocessed_image",
          "preview_files",
          "report_file",
          "output_format",
          "bake_texture",
          "has_vertex_colors",
          "vertices",
          "faces",
          "mc_resolution",
          "density_threshold",
          "model_id",
          "model_revision",
          "source_revision",
          "device",
          "gpu_index",
          "cuda_marching_cubes",
          "peak_vram_bytes",
          "load_seconds",
