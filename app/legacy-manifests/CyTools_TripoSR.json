          "total_seconds",
          "warnings"
        ],
        "additionalProperties": false
      },
      "outputs": [
        {
          "id": "mesh_file",
          "type": "Mesh",
          "description": "Reconstructed mesh in the requested format.",
          "mimeType": "model/gltf-binary",
          "fileExtension": ".glb",
          "metadata": {
            "alternateMimeType": "model/obj",
            "alternateFileExtension": ".obj"
          }
        },
        {
