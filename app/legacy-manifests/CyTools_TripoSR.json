            "type": "string"
          },
          "device": {
            "type": "string"
          },
          "gpu_index": {
            "type": "integer",
            "minimum": 0
          },
          "cuda_marching_cubes": {
            "type": "boolean"
          },
          "peak_vram_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "load_seconds": {
            "type": "number",
            "minimum": 0
          },
          "inference_seconds": {
            "type": "number",
            "minimum": 0
          },
          "mesh_seconds": {
            "type": "number",
            "minimum": 0
          },
