          "mimeType": "image/png",
          "fileExtension": ".png"
        },
        {
          "id": "preview_files",
          "type": "ImageSet",
          "description": "Optional NeRF turntable previews.",
          "optional": true,
          "mimeType": "image/png",
          "fileExtension": ".png"
        },
        {
          "id": "report_file",
          "type": "JSON",
          "description": "Every returned field, written next to the artifacts.",
          "mimeType": "application/json",
          "fileExtension": ".json"
        }
      ],
