  "operations": [
    {
      "id": "image_to_mesh",
      "name": "Image to 3D mesh",
      "description": "Reconstruct one object from a single image as GLB or OBJ. Vertex colours by default, optional baked texture atlas. The hidden side is inferred by the network, not measured.",
      "estimatedDurationSeconds": 45,
      "inputSchema": {
        "type": "object",
        "properties": {
          "image_file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "x-cy-kind": "File",
            "description": "PNG/JPEG/WEBP inside CYTOOLS_TRIPOSR_INPUT_ROOT (default: inputs)."
          },
          "mc_resolution": {
            "type": "integer",
            "enum": [
              128,
              192,
              256,
              320,
              384
            ],
            "default": 256,
            "x-cy-kind": "Enum",
            "description": "Marching cubes grid resolution. Lower is faster and coarser."
          },
          "density_threshold": {
            "type": "number",
            "minimum": 1,
            "maximum": 100,
            "default": 25,
            "x-cy-kind": "Float",
            "x-cy-ui": {
              "advanced": true,
              "step": 1,
              "help": "Isosurface level in the predicted density field. Higher shrinks the surface."
            }
          },
          "chunk_size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 131072,
            "default": 8192,
            "x-cy-kind": "Integer",
            "x-cy-ui": {
              "advanced": true,
              "help": "Triplane query batch. Smaller uses less VRAM and is slower; 0 disables chunking."
            }
          },
          "output_format": {
            "enum": [
              "glb",
              "obj"
            ],
            "default": "glb",
            "x-cy-kind": "Enum",
            "description": "GLB carries vertex colours. Baking a texture atlas requires obj."
          },
          "bake_texture": {
            "type": "boolean",
            "default": false,
            "description": "Bake a texture atlas with xatlas and moderngl instead of vertex colours. Needs a working OpenGL context and output_format obj."
          },
          "texture_resolution": {
            "type": "integer",
            "enum": [
              512,
              1024,
              2048
            ],
            "default": 1024,
            "x-cy-kind": "Enum",
            "x-cy-ui": {
              "advanced": true
            }
          },
          "remove_background": {
            "type": "boolean",
            "default": true,
            "description": "Run rembg on the input. Disable only for an image that already has a clean, centred foreground."
          },
          "foreground_ratio": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 1,
            "default": 0.85,
            "x-cy-kind": "Float",
            "x-cy-ui": {
              "step": 0.05
            },
            "description": "Fraction of the frame occupied by the object after cropping."
          },
          "device": {
            "enum": [
              "cuda",
              "cpu"
            ],
            "default": "cuda",
            "x-cy-kind": "Enum",
            "description": "CPU is supported by the upstream code but is far slower; it is not a validated path here."
          },
          "gpu_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15,
            "default": 0,
            "x-cy-kind": "Integer",
            "description": "NVIDIA device index, ignored when device is cpu."
          },
          "preview_views": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8,
            "default": 0,
            "x-cy-kind": "Integer",
            "description": "Number of NeRF-rendered turntable PNG previews. 0 skips rendering."
          },
          "preview_size": {
            "type": "integer",
            "enum": [
              128,
              256,
              512
            ],
            "default": 256,
            "x-cy-kind": "Enum",
            "x-cy-ui": {
              "advanced": true
            }
          },
          "model_profile": {
            "type": "string",
            "default": "",
            "description": "ID from the local model library; empty uses the selected built-in model."
          }
        },
        "required": [
          "image_file"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "bake_texture": {
                  "const": true
                }
              },
              "required": [
                "bake_texture"
              ]
            },
            "then": {
              "properties": {
                "output_format": {
                  "const": "obj"
                }
              },
              "required": [
                "output_format"
              ]
            }
          }
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "mesh_file": {
            "type": "string",
            "x-cy-kind": "File"
          },
          "texture_file": {
            "type": "string",
            "description": "Empty string when vertex colours are used."
          },
          "preprocessed_image": {
            "type": "string",
            "x-cy-kind": "File"
          },
          "preview_files": {
            "type": "array",
            "items": {
