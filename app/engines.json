      "label": "Geometry engine (CPU: remesh, UV, PBR bake, mesh edit)",
      "directory": "runtime/engines/geometry",
      "python": "3.11",
      "requirements": "requirements-engine-geometry.txt",
      "verify": [
        "numpy",
        "trimesh",
        "xatlas",
        "PIL",
        "scipy",
        "networkx"
      ],
      "backends": [
        "autoremesher",
        "quadwild",
        "xatlas",
        "pbrbake",
        "meshedit",
        "proxyfit"
      ],
      "natives": {
