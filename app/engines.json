      "estimatedBytes": 11000000000,
      "verificationNote": "Kept separate from the diffusion engine on purpose: this stack is transformers 5.x with huggingface_hub 1.x, which diffusers 0.35.2 does not support.",
      "wheels": {
        "platform": "win32",
        "baseUrl": "https://github.com/Quentincls/localmesh-engine/releases/download/wheels-cp312-cu128/",
        "note": "Three CUDA extensions (cumesh, flex_gemm, o_voxel) plus natten, compiled against torch 2.8.0+cu128 for CPython 3.12 on Windows. They are not on PyPI and pip install cumesh would fetch a different project of the same name, so they are pinned by SHA-256 and installed with --no-deps. Linux needs a source build: not done, not claimed.",
        "files": {
          "cumesh-1.0-cp312-cp312-win_amd64.whl": "125077f7cdbb3f274ed599abc17634af1aa2bdaac4f0354f91671acdf28c91b3",
          "flex_gemm-0.0.1-cp312-cp312-win_amd64.whl": "410efe0dddc64ce7379fdb157f1336b338e7bf9821c097de3d9b32839158869b",
          "natten-0.21.6-cp312-cp312-win_amd64.whl": "9a494a9e1642775e08e187934938c661d1279ab43e6ed29af7a5bbde25d875fb",
          "o_voxel-0.0.1-cp312-cp312-win_amd64.whl": "4126de7c3578d966a0d079d7a0eefcfbaf80dc1f28482649ba390cfed121bda3"
        }
      },
      "installSources": [
        "localmesh-engine"
      ],
      "modelLayout": {
        "note": "The engine expects the folder names its upstream catalogue uses, while the Tool stores one canonical copy per model under data/models with catalogue ids. This layout is a directory of junctions (Windows) or symlinks (POSIX) pointing at those canonical folders: no weight is copied or renamed, and several engines can expect different names for the same weights.",
        "root": "runtime/engines/trellis/model-root",
        "links": {
          "models/TRELLIS.2-4B": "data/models/trellis2-4b",
          "models/microsoft/TRELLIS-image-large": "data/models/trellis-image-large",
          "models/microsoft/TRELLIS.2-4B": "data/models/trellis2-4b-reconviagen",
          "models/multivue": "data/models/localmesh-multivue",
          "models/facebook/dinov3-vitl16-pretrain-lvd1689m": "data/models/dinov3-vitl16",
          "models/BiRefNet_HR": "data/models/birefnet-hr",
          "models/hf": "data/models/localmesh-hf-modules"
        },
        "env": {
          "LOCALMESH_ROOT": "{root}",
          "HF_HOME": "{root}/models/hf"
        }
      },
      "verifyStatements": [
        {
          "label": "natten CUDA kernels",
          "code": "import natten; assert natten.HAS_LIBNATTEN, \"natten has no CUDA library\""
        },
        {
          "label": "o_voxel through the nvdiffrast stand-in",
          "code": "from localmesh_engine import leurre_nvdiffrast; leurre_nvdiffrast.installer(); import o_voxel; assert o_voxel is not None",
          "note": "o_voxel imports nvdiffrast at module level, and nvdiffrast is non-commercial, so the engine installs a stand-in first. Importing o_voxel on its own therefore fails by design: it must be checked through that stand-in."
        },
        {
          "label": "CUDA device",
          "code": "import torch; assert torch.cuda.is_available(), \"no CUDA device\""
        }
      ]
    },
