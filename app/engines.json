      "verify": [
        "torch",
        "torchvision",
        "transformers",
        "trimesh",
        "torchmcubes",
        "texture_baker",
        "uv_unwrapper",
        "spconv",
        "bpy",
        "open3d",
        "alpha_clip"
      ],
      "backends": [
        "triposr",
        "spar3d",
        "unirig"
      ],
      "estimatedBytes": 12000000000,
      "verificationNote": "TripoSR and SPAR3D were installed upstream with transformers 4.42.3 / trimesh 4.4.1, UniRig with transformers 4.51.3 / trimesh 5.1.0. The merged engine pins the newer pair; each of the three backends must be executed here before it is declared supported.",
      "wheelIndexes": [
        {
          "label": "PyTorch Geometric wheels for torch 2.5.1+cu124 (torch-scatter, torch-cluster)",
          "url": "https://data.pyg.org/whl/torch-2.5.1+cu124.html",
          "packages": [
            "torch-scatter==2.1.2",
            "torch-cluster==1.6.3"
          ]
        }
      ],
      "nativeBuild": {
        "note": "Three extensions have no wheel for this ABI and must be compiled: torchmcubes for TripoSR, texture_baker and uv_unwrapper for SPAR3D. The official CUDA 12.4 redistributables are downloaded into runtime/cuda-12.4 and the MSVC toolchain is loaded into the installer process only: no driver, no machine PATH and no system CUDA installation is touched.",
        "cuda": {
          "version": "12.4",
          "manifest": "redistrib_12.4.1.json",
          "baseUrl": "https://developer.download.nvidia.com/compute/cuda/redist/",
          "directory": "runtime/cuda-12.4",
          "components": [
            "cuda_nvcc",
            "cuda_cudart",
            "cuda_cccl",
            "cuda_nvtx",
            "libcublas",
            "libcusparse",
            "libcusolver",
            "libcurand"
          ],
          "architectures": "75-real;80-real;86-real;89-real;90-virtual"
        },
        "msvc": "14.38",
        "packages": [
          {
            "label": "torchmcubes (TripoSR marching cubes)",
            "spec": "git+https://github.com/tatsy/torchmcubes.git@879926d0ef58e6ce0ac2630fdecb5e53af7ed3ff"
          },
          {
            "label": "texture_baker (SPAR3D)",
            "source": "SPAR3D",
            "path": "texture_baker"
          },
          {
            "label": "uv_unwrapper (SPAR3D)",
            "source": "SPAR3D",
            "path": "uv_unwrapper"
          }
        ]
      },
      "verifyStatements": [
        {
          "label": "torchmcubes CUDA kernels",
          "code": "import torchmcubes; assert hasattr(torchmcubes, \"HAS_CUDA\")"
        },
        {
          "label": "CUDA device",
          "code": "import torch; assert torch.cuda.is_available()"
        },
        {
          "label": "torch-scatter and torch-cluster",
          "code": "import torch_scatter, torch_cluster"
        }
      ],
      "pipExtra": [
        {
          "label": "setuptools for legacy setup.py builds",
          "spec": "setuptools<81"
        },
        {
          "label": "CLIP (SPAR3D conditioning)",
          "spec": "git+https://github.com/openai/CLIP.git",
          "noBuildIsolation": true
        },
        {
          "label": "AlphaCLIP (SPAR3D region conditioning)",
          "spec": "git+https://github.com/SunzeY/AlphaCLIP.git",
          "noBuildIsolation": true
        }
      ]
    },
